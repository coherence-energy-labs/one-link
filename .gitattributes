# Shell entry points execute on Linux/macOS runners and must never acquire
# Windows CRLF bytes (which break shebangs and can corrupt continued commands).
*.sh text eol=lf

# Preserve the exact reviewed upstream crate bytes on every checkout platform.
native/ol_shell/vendor/** -text -whitespace
native/vendor/** -text -whitespace
native/patches/** text eol=lf
native/patches/*.patch -whitespace
native/ol_shell/patches/** text eol=lf
# A unified diff's blank context lines and the original license retain their
# upstream whitespace; changing either would invalidate the reviewed bytes.
native/ol_shell/patches/*.patch -whitespace

# Canonical JSON bytes are part of the JavaScript ownership gate.
tests/js/ownership_baseline.json text eol=lf
